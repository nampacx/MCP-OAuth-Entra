{
  "$schema": "https://aka.ms/bicep-config-schema",
  "analyzers": {
    "core": {
      "enabled": true,
      "verbose": false,
      "rules": {
        "no-unused-params": { "level": "warning" },
        "no-unused-vars": { "level": "warning" },
        "no-hardcoded-location": { "level": "warning" },
        "secure-secrets-in-params": { "level": "warning" }
      }
    }
  }
}
